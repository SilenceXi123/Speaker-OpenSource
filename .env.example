APP_ENV=dev
APP_PORT=8787

# 阿里云百炼
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
DASHSCOPE_REGION=cn-beijing
DASHSCOPE_ASR_MODEL=fun-asr
DASHSCOPE_ROCKETMQ_ENABLED=false
DASHSCOPE_ROCKETMQ_ENDPOINTS=
DASHSCOPE_ROCKETMQ_INSTANCE_ID=
DASHSCOPE_ROCKETMQ_TOPIC=
DASHSCOPE_ROCKETMQ_CONSUMER_GROUP=
DASHSCOPE_ROCKETMQ_ACCESS_KEY=
DASHSCOPE_ROCKETMQ_ACCESS_SECRET=
DASHSCOPE_ROCKETMQ_BATCH_SIZE=8
DASHSCOPE_ROCKETMQ_INVISIBLE_DURATION_SECONDS=15

# 字幕增强：长音频限时处理，避免任务长时间卡在 92%
SUBTITLE_ENHANCER_ENABLED=true
SUBTITLE_ENHANCER_PROVIDER=deepseek
SUBTITLE_ENHANCER_API_KEY=
SUBTITLE_ENHANCER_BASE_URL=https://api.deepseek.com
SUBTITLE_ENHANCER_MODEL=deepseek-v4-flash
SUBTITLE_ENHANCER_TIMEOUT_SECONDS=30
SUBTITLE_ENHANCER_MAX_BATCH_CHARS=2200
SUBTITLE_ENHANCER_MAX_BATCH_SEGMENTS=12
SUBTITLE_ENHANCER_MAX_WORKERS=4
SUBTITLE_ENHANCER_MAX_SEGMENTS_PER_JOB=220
SUBTITLE_ENHANCER_MAX_RETRY_SEGMENTS=8
SUBTITLE_ENHANCER_JOB_TIMEOUT_SECONDS=240
SUBTITLE_ENHANCER_WINDOW_SECONDS=600
SUBTITLE_ENHANCER_WINDOW_MAX_SECONDS=780
SUBTITLE_ENHANCER_WINDOW_MIN_GAP_MS=800

# 阿里云 OSS
OSS_REGION=oss-cn-beijing
OSS_BUCKET=
OSS_PUBLIC_BASE_URL=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# 上传目录约定
OSS_UPLOAD_PREFIX=uploads/source
OSS_AUDIO_PREFIX=uploads/audio
OSS_SUBTITLE_PREFIX=outputs/subtitles
OSS_RENDER_PREFIX=outputs/rendered
OSS_LOWER_THIRD_PREFIX=assets/lower-thirds

# 本地临时目录
LOCAL_UPLOAD_DIR=backend/data/tmp/uploads
LOCAL_AUDIO_DIR=backend/data/tmp/audio
LOCAL_RENDER_DIR=backend/data/tmp/render

# 生产存储保护：定时清理 2.0 临时文件和过期任务源文件，旧任务不会自动纳入
STORAGE_CLEANUP_ENABLED=true
STORAGE_CLEANUP_INTERVAL_SECONDS=3600
STORAGE_CLEANUP_TMP_DAYS=1
STORAGE_CLEANUP_COMPLETED_SOURCE_DAYS=15
STORAGE_CLEANUP_FAILED_SOURCE_DAYS=7
STORAGE_CLEANUP_STALE_ACTIVE_HOURS=48
# prod/production 环境同时满足“至少保留 8GB”和“使用率不超过 85%”
STORAGE_MIN_FREE_GB=8
STORAGE_MAX_USED_PERCENT=85

# 局域网客户端自动更新
CLIENT_UPDATE_ENABLED=false
CLIENT_UPDATE_DIR=backend/data/client-updates
CLIENT_UPDATE_PUBLIC_BASE_URL=

# 声音复刻：创建与生成使用同一模型；开关关闭时拒绝上传、创建、复用创建和生成
VOICE_CLONING_ENABLED=false
VOICE_CLONING_PROVIDER=qwen
VOICE_CLONING_REGION=cn-beijing
# Next 使用现有百炼业务空间 ID，与 API Key 编号不同
SFM_WORKSPACE_ID=
VOICE_CLONING_COSYVOICE_TARGET_MODEL=cosyvoice-v3.5-plus
VOICE_CLONING_QWEN_TARGET_MODEL=qwen3-tts-vc-2026-01-22
