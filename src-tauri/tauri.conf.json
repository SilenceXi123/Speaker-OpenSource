{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Speaker 客户端",
  "version": "2.0.19",
  "identifier": "com.silence.speaker-open-source",
  "build": {
    "beforeDevCommand": "npm run desktop:web",
    "beforeBuildCommand": "npm run desktop:web",
    "frontendDist": "../desktop-web"
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": [],
      "pubkey": "",
      "dangerousInsecureTransportProtocol": true
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Speaker 客户端",
        "width": 1480,
        "height": 980,
        "minWidth": 1180,
        "minHeight": 820,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "capabilities": [
        "main-capability"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "resources": {
      "resources/speaker-speech": "speaker-speech",
      "resources/offline-core/": "offline-core/",
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../THIRD_PARTY_LICENSES.txt": "THIRD_PARTY_LICENSES.txt"
    }
  }
}
